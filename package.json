{
  "name": "vennperio",
  "version": "1.0.0",
  "private": true,
  "description": "Jogo multiplayer educacional de conquista de território e teoria dos conjuntos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 test/lifeLoss.test.js test/pathSegments.test.js test/snapshotInterpolator.test.mjs",
    "check": "node scripts/check-syntax.js",
    "check:server": "node scripts/check-syntax.js server",
    "check:client": "node scripts/check-syntax.js client",
    "check:shared": "node scripts/check-syntax.js shared"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "polygon-clipping": "^0.15.7",
    "socket.io": "^4.8.3"
  }
}
