{
  "name": "vennperio",
  "version": "1.0.0",
  "private": true,
  "description": "Jogo multiplayer educacional de conquista de território e teoria dos conjuntos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.js",
    "benchmark:bots": "node --expose-gc scripts/run-bots-soak.js",
    "benchmark:capacity": "node scripts/run-capacity-matrix.js",
    "diagnostic:connections": "node scripts/run-massive-connections.js",
    "check": "node scripts/check-syntax.js",
    "check:server": "node scripts/check-syntax.js server",
    "check:client": "node scripts/check-syntax.js client",
    "check:shared": "node scripts/check-syntax.js shared"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "clipper2-wasm": "^0.4.0",
    "express": "^5.2.1",
    "polygon-clipping": "^0.15.7",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
